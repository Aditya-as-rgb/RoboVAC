<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vacuum_bringup</name>
  <version>0.1.0</version>
  <description>
    SLAM + Nav2 bringup and RViz configs for the simulated vacuum robot.
    Derived from makerspet/oomwoo-ros2-tools (Apache-2.0).
  </description>
  <maintainer email="you@example.com">TODO your name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>vacuum_gazebo</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>vacuum_teleop</exec_depend>
  <exec_depend>vacuum_coverage</exec_depend>
  <exec_depend>vacuum_vision</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
