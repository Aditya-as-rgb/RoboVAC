<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vacuum_gui</name>
  <version>0.1.0</version>
  <description>
    PySide6 control panel for the RoboVAC simulation: launch manager, live map and camera
    views drawn from ROS topics (no embedded Gazebo or RViz), health dashboard, mission
    controls, dataset collection and a blind-vs-vision experiment runner.
  </description>
  <maintainer email="adi@example.com">adi</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>action_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_python</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>vacuum_bringup</exec_depend>
  <exec_depend>vacuum_coverage</exec_depend>
  <exec_depend>vacuum_vision</exec_depend>
  <exec_depend>vacuum_teleop</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
